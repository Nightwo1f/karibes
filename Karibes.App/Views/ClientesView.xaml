<UserControl x:Class="Karibes.App.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Karibes.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                Padding="20,15"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Clientes"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Novo Cliente"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NovoClienteCommand}"
                            Margin="5,0"/>
                    <Button Content="Atualizar"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AtualizarCommand}"
                            Margin="5,0"/>
                    <Button Content="Exportar PDF"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportarPdfCommand}"
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Buscar"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,10"
                             Tag="Buscar por nome, CPF/CNPJ, telefone ou ID..."/>

                    <TextBlock Text="Status"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5"/>
                    <ComboBox SelectedValue="{Binding StatusSelecionado}"
                              SelectedValuePath="Content"
                              Style="{StaticResource ModernComboBox}"
                              Width="180"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                    </ComboBox>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ClientesFiltrados}"
                          SelectedItem="{Binding ClienteSelecionado}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DividaVencida}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DividaProximaVencimento}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningOrangeBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditarClienteCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="120"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoDocumento}" Width="60"/>
                        <DataGridTextColumn Header="Credito Disponivel" Width="130">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="R$ {0:N2}">
                                    <MultiBinding.Converter>
                                        <converters:SubtractConverter/>
                                    </MultiBinding.Converter>
                                    <Binding Path="LimiteCredito"/>
                                    <Binding Path="SaldoDevedor"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Compras do cliente selecionado"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ComprasCliente}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding DataVenda, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95"/>
                                <DataGridTextColumn Header="Venda" Binding="{Binding NumeroVenda}" Width="90"/>
                                <DataGridTextColumn Header="Pagamento" Binding="{Binding FormaPagamento}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2"
                Background="#99000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsModalAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20"
                    MaxWidth="820"
                    MaxHeight="680"
                    Margin="30"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cadastro de Cliente"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Fechar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelarEdicaoCommand}"
                                Padding="12,6"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dados do Cliente"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Nome / Razao Social *"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ClienteEditando.Nome, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tipo"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox SelectedValue="{Binding ClienteEditando.TipoDocumento}"
                                              SelectedValuePath="Content"
                                              Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="CPF"/>
                                        <ComboBoxItem Content="CNPJ"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Documento"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Documento, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Telefone"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Telefone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Celular"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Celular, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Email"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Endereco"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="CEP"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.CEP, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Endereco"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Endereco, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Numero"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Numero, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Bairro"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Bairro, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cidade"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Cidade, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Estado"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.Estado, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"
                                             MaxLength="2"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Complemento"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ClienteEditando.Complemento, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Credito"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Limite de Credito"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ClienteEditando.LimiteCredito, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ZeroToEmptyConverter}}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Vencimento do Credito"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding ClienteEditando.DataVencimentoCredito}"
                                                Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Status"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,12"/>
                                    <CheckBox Content="Cliente Ativo"
                                              IsChecked="{Binding ClienteEditando.Ativo}"
                                              Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Saldo Devedor"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding ClienteEditando.SaldoDevedor, StringFormat='R$ {0:N2}'}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="Red"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Total Pago"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding ClienteEditando.TotalPago, StringFormat='R$ {0:N2}'}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="Green"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClienteEditando.SaldoDevedor, Converter={StaticResource DecimalGreaterThanZeroConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Abater Divida"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Valor do Pagamento"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding ValorPagamento, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ZeroToEmptyConverter}}"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Data do Pagamento"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Margin="0,0,0,5"/>
                                            <DatePicker SelectedDate="{Binding DataPagamento}"
                                                        Style="{StaticResource ModernDatePicker}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Observacao"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ObservacaoPagamento, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="50"
                                             Margin="0,0,0,10"/>

                                    <Button Content="Registrar Pagamento"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RegistrarPagamentoCommand}"
                                            HorizontalAlignment="Right"
                                            Padding="20,8"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Observacoes"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ClienteEditando.Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="70"
                                     Margin="0,0,0,12"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Salvar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SalvarClienteCommand}"
                                Margin="0,0,10,0"
                                Padding="20,8"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelarEdicaoCommand}"
                                Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
